generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model FieldRecord {
  id             String   @id @default(uuid())
  plot           String
  crop           String
  location       String
  capturedAt     DateTime
  ndvi           Float
  ndre           Float
  gndvi          Float
  moisture       Int
  temperature    Int
  nitrogen       Int
  phosphorus     Int
  potassium      Int
  waterStress    String
  nutrientStress String
  healthScore    Int
  status         String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
